---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '漢方舎はふり屋は、東京都杉並区にある漢方カウンセリング専門店です。一人ひとりの体質・生活習慣に合わせた漢方の提案で、自分の力で健康を取り戻すお手伝いをします。',
} = Astro.props;

const siteName = '漢方舎はふり屋';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title === siteName ? siteName : `${title} | ${siteName}`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- モバイル用スティッキーCTA -->
    <div class="mobile-sticky-cta">
      <a href="/contact" class="btn btn-accent">ご予約・お問い合わせ</a>
    </div>
  </body>
</html>

<style>
.mobile-sticky-cta {
  display: none;
}
@media (max-width: 768px) {
  .mobile-sticky-cta {
    display: flex;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    padding: var(--sp-sm) var(--sp-lg);
    padding-bottom: calc(var(--sp-sm) + env(safe-area-inset-bottom));
    background: rgba(248, 246, 241, .96);
    backdrop-filter: blur(8px);
    border-top: 1px solid var(--border);
  }
  .mobile-sticky-cta .btn {
    width: 100%;
    justify-content: center;
  }
}
</style>
